      {
        "id": "B",
        "text": {
          "en": "9x² - 12x + 16",
          "hi": "9x² - 12x + 16",
          "te": "9x² - 12x + 16",
          "reviewed": false
        },
        "mistakeTag": "forgot_factor_of_two_in_middle_term"
      },
      {
        "id": "C",
        "text": {
          "en": "9x² - 24x + 16",
          "hi": "9x² - 24x + 16",
          "te": "9x² - 24x + 16",
          "reviewed": false
        }
      },
      {
        "id": "D",
