      "reviewed": false
    },
    "options": [
      {
        "id": "A",
        "text": {
          "en": "(x + 1)(x + 15)",
          "hi": "(x + 1)(x + 15)",
          "te": "(x + 1)(x + 15)",
          "reviewed": false
        },
        "mistakeTag": "incorrect_factor_pair_sum"
      },
      {
        "id": "B",
        "text": {
          "en": "(x + 3)(x + 5)",
          "hi": "(x + 3)(x + 5)",
          "te": "(x + 3)(x + 5)",
          "reviewed": false
        }
      },
      {
        "id": "C",
        "text": {
          "en": "(x - 3)(x - 5)",
          "hi": "(x - 3)(x - 5)",
          "te": "(x - 3)(x - 5)",
          "reviewed": false
        },
        "mistakeTag": "both_factors_negative_for_positive_middle_term"
      },
      {
        "id": "D",
        "text": {
          "en": "(x + 2)(x + 6)",
          "hi": "(x + 2)(x + 6)",
          "te": "(x + 2)(x + 6)",
          "reviewed": false
        },
        "mistakeTag": "incorrect_factor_pair_product"
      }
    ],
    "correctAnswer": "B",
    "explanation": {
      "en": "We need two numbers that multiply to 15 and add to 8. The numbers are 3 and 5 (3 × 5 = 15, 3 + 5 = 8). Thus, x² + 8x + 15 = (x + 3)(x + 5).",
      "hi": "हमें ऐसी दो संख्याएँ चाहिए जिनका गुणनफल 15 और योग 8 हो। वे संख्याएँ 3 और 5 हैं (3 × 5 = 15, 3 + 5 = 8)। अतः x² + 8x + 15 = (x + 3)(x + 5)।",
      "te": "లబ్దం 15 మరియు మొత్తం 8 అయ్యే రెండు సంఖ్యలు కావాలి. ఆ సంఖ్యలు 3 మరియు 5 (3 × 5 = 15, 3 + 5 = 8). కాబట్టి x² + 8x + 15 = (x + 3)(x + 5).",
      "reviewed": false
    },
    "hint": {
      "en": "List the factor pairs of 15: (1, 15) and (3, 5). Which pair adds up to 8?",
      "hi": "15 के गुणनखंड जोड़ियों की सूची बनाएं: (1, 15) और (3, 5)। किस जोड़ी का योग 8 है?",
      "te": "15 యొక్క కారణాంక జతలను చూడండి: (1, 15) మరియు (3, 5). ఏ జత మొత్తం 8 అవుతుంది?",
      "reviewed": false
    }
