# Margam Environment Variables
NEXT_PUBLIC_APP_NAME="Margam"
NEXT_PUBLIC_APP_TAGLINE="Every learner has a path. Find yours."
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Supabase Configuration (Phase 1 Placeholders - Do not commit real keys)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Server-Only Secret Key (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
# Translation Draft Control
# Set to 'true' to display unreviewed Hindi/Telugu question drafts with visual draft badges.
# Defaults to 'false' (unreviewed translations fall back cleanly to English).
NEXT_PUBLIC_SHOW_DRAFT_TRANSLATIONS="false"

# Demo Mode Unlock Switch
# When set to 'true', unlocks all full chapters and their lessons for testing.
# Defaults to 'false'.
# IMPORTANT: This must STAY 'false' on Vercel and production deployments.
NEXT_PUBLIC_DEMO_UNLOCK="false"
