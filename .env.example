# ==============================================================================
# MARGAM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.local' for local development.
# Configure these variables in Vercel Project Settings for Preview & Production.
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BRANDING (Public / Client-Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Margam"
NEXT_PUBLIC_APP_TAGLINE="Every learner has a path. Find yours."
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# ------------------------------------------------------------------------------
# 2. SUPABASE CONNECTION (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon Key (Primary standard key)
# Supported alias: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# ------------------------------------------------------------------------------
# 3. SUPABASE SERVICE ROLE (Server-Only / STRICT SECRET)
# ------------------------------------------------------------------------------
# Privileged service role key for trusted backend operations (bypasses RLS).
# Used strictly in server-only route handlers for profile creation, class setup,
# and server-side progression evaluation.
#
# CRITICAL SECURITY RULES:
# - NEVER expose to browser.
# - NEVER prefix with NEXT_PUBLIC_.
# - NEVER commit real keys to version control.
#
# Supported aliases: SUPABASE_SECRET_KEY, SUPABASE_SERVICE_KEY
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key-here"

# ------------------------------------------------------------------------------
# 4. SESSION SECURITY (Server-Only / STRICT SECRET)
# ------------------------------------------------------------------------------
# High-entropy random secret key (minimum 32 characters) used to sign:
# - Diagnostic, practice, and test session tokens (anti-tamper question verification)
# - Student authentication session cookies
#
# In local development: defaults to internal fallback key if unset.
# In production (Vercel): REQUIRED to maintain session continuity across serverless functions.
SESSION_SECRET="generate-a-strong-random-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS & PEDAGOGY CONTROLS (Public / Client-Safe)
# ------------------------------------------------------------------------------
# Enables student and teacher login & registration systems
NEXT_PUBLIC_FEATURE_LOGIN="true"

# Translation Draft Control:
# Set to 'true' to display unreviewed Hindi/Telugu question drafts with visual draft badges.
# Defaults to 'false' (unreviewed translations fall back cleanly to English).
NEXT_PUBLIC_SHOW_DRAFT_TRANSLATIONS="false"

# Teacher portal & class management tools
NEXT_PUBLIC_FEATURE_TEACHER_TOOLS="true"

# Interactive AI Tutor assistance (Phase 2 feature)
NEXT_PUBLIC_FEATURE_TUTOR="false"

# Demo Unlock Mode: Set to 'false' in production; 'true' to unlock all chapters in demo mode
NEXT_PUBLIC_DEMO_UNLOCK="false"
